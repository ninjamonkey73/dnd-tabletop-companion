{
  "name": "dnd-tabletop-companion",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "serve:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/serve-prod.ps1",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:ci": "ng test --watch=false",
    "watch": "ng build --watch --configuration development",
    "open": "ng serve --open",
    "add-404": "npx cpy-cli dist/dnd-tabletop-companion/browser/index.html dist/dnd-tabletop-companion/browser --rename=404.html",
    "style:check": "powershell -ExecutionPolicy Bypass -File [check-templates.ps1](http://_vscodecontentref_/12)",
    "find:unused-css": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/find-unused-css.ps1",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.8",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^21.2.8",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "firebase": "^12.12.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@playwright/test": "1.65.1",
    "@vitest/coverage-v8": "^4.1.5",
    "cpy": "^13.2.1",
    "jsdom": "^29.0.2",
    "playwright-ng-schematics": "^22.1.4",
    "rimraf": "^6.0.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-prune": "^0.10.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  }
}